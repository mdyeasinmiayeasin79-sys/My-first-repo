<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Bangla Yeasin Earn</title>

<link rel="stylesheet" href="style.css">
</head>

<body>

<header>
<h1>Bangla Yeasin Earn</h1>
<p>Earn Money Online</p>
</header>

<div class="container">

<div class="card balance">
<h2>৳ <span id="balance">0.00</span></h2>
<p>Wallet Balance</p>
</div>

<div class="card">
<h3>🎥 Video Task</h3>
<p>Watch 30 Seconds</p>
<button onclick="videoTask()">Watch Now</button>
</div>

<div class="card">
<h3>📢 Ad Task</h3>
<p>View One Advertisement</p>
<button onclick="adTask()">Start Task</button>
</div>

<div class="card">
<h3>🎁 Daily Bonus</h3>
<button onclick="dailyBonus()">Claim Bonus</button>
</div>

<div class="card">
<h3>👥 Referral</h3>
<p>Your Referral Link</p>
<input type="text" value="https://banglayeasinearn.github.io/?ref=USER001" readonly>
</div>

<div class="card">
<h3>💸 Withdraw</h3>
<p>Minimum Withdraw ৳500</p>
<button onclick="withdraw()">Withdraw</button>
</div>

</div>

<script src="app.js"></script>

</body>
</html>
*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,sans-serif;
}

body{
background:#f5f5f5;
}

header{
background:#008000;
color:#fff;
text-align:center;
padding:20px;
}

.container{
max-width:450px;
margin:auto;
padding:15px;
}

.card{
background:#fff;
margin-bottom:15px;
padding:20px;
border-radius:15px;
box-shadow:0 5px 15px rgba(0,0,0,.1);
}

.balance{
background:linear-gradient(135deg,#009900,#00cc66);
color:#fff;
text-align:center;
}

.balance h2{
font-size:42px;
margin-bottom:8px;
}

button{
width:100%;
padding:14px;
border:none;
border-radius:10px;
background:#008000;
color:#fff;
font-size:18px;
cursor:pointer;
}

button:hover{
background:#006600;
}

input{
width:100%;
padding:12px;
border:1px solid #ccc;
border-radius:8px;
margin-top:10px;
}let balance = 0;
let bonusClaimed = false;

function updateBalance() {
    document.getElementById("balance").innerText = balance.toFixed(2);
}

function videoTask() {
    alert("ভিডিও দেখুন, ৩০ সেকেন্ড অপেক্ষা করুন...");
    setTimeout(() => {
        balance += 5;
        updateBalance();
        alert("আপনি ৳5 পেয়েছেন!");
    }, 30000);
}

function adTask() {
    balance += 2;
    updateBalance();
    alert("Ad Task সম্পন্ন! ৳2 যোগ হয়েছে।");
}

function dailyBonus() {
    if (bonusClaimed) {
        alert("আজকের বোনাস ইতিমধ্যে নেওয়া হয়েছে।");
        return;
    }

    balance += 10;
    bonusClaimed = true;
    updateBalance();
    alert("Daily Bonus ৳10 যোগ হয়েছে!");
}

function withdraw() {
    if (balance >= 500) {
        alert("Withdraw Request Submitted!");
        balance = 0;
        updateBalance();
    } else {
        alert("Minimum Withdraw ৳500");
    }
}

updateBalance();
